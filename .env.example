# 复制成 .env 后填写。.env 不会被提交。

# ---- LLM ----
# 可选值：deepseek | openai_compatible
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# 仅 openai_compatible 需要，例如 https://api.example.com/v1
LLM_BASE_URL=
LLM_TEMPERATURE=1.0

# ---- TTS ----
# M1 只有 edge 一个后端，见 docs/adr/0001
TTS_BACKEND=edge
TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural
TTS_EDGE_RATE=+0%

# ---- Live2D ----
LIVE2D_MODEL_PATH=models/hiyori
LIVE2D_WINDOW_WIDTH=400
LIVE2D_WINDOW_HEIGHT=600

# ---- 其他 ----
LOG_LEVEL=INFO
